# ======================================================================
#  iPad Asset Management v2 – konfigurasi backend. Salin ke .env, JANGAN commit .env.
# ======================================================================
NODE_ENV=production
HOST=127.0.0.1
PORT=4000
# URL yang dibuka user (wajib https di production) – dipakai juga di link reset password
BASE_URL=https://ipad.hirose-idn.example
TRUST_PROXY=1

# PostgreSQL 13+ (lihat deploy/db-roles.sql). App pakai user DML saja.
DATABASE_URL=postgresql://ipad_app:GANTI@localhost:5433/ipad_asset
DATABASE_URL_MIGRATE=postgresql://ipad_owner:GANTI@localhost:5433/ipad_asset
DB_SSL=false

# Session (npm run gen-keys)
SESSION_SECRET=
SESSION_IDLE_MIN=60
SESSION_MAX_HOURS=10

# Enkripsi credential AES-256-GCM: id:base64(32 byte). SIMPAN CADANGAN DI BRANKAS.
DATA_KEYS=
DATA_KEY_ACTIVE=k1
HMAC_KEY=

# SMTP kantor untuk email reset password
SMTP_HOST=smtp.hirose.co.id
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="iPad Asset Management <no-reply@hirose.co.id>"

# Email user yang boleh dibuat (pisahkan koma, kosong = bebas)
ALLOWED_EMAIL_DOMAINS=hirose.co.id

UPLOAD_DIR=D:\\ipad-asset-data\\uploads
MAX_UPLOAD_MB=5
LOG_LEVEL=info
