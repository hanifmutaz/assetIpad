# ======================================================================
#  iPad Asset Management – konfigurasi backend
#  Salin ke .env lalu isi. JANGAN commit file .env ke Git.
# ======================================================================
NODE_ENV=production
HOST=127.0.0.1
PORT=4000
# URL publik aplikasi (yang dibuka user di browser). Wajib https di production.
BASE_URL=https://ipad.hirose-idn.example
# Jumlah reverse proxy di depan Node (IIS = 1, IIS + Cloudflare Tunnel tetap 1 hop ke Node)
TRUST_PROXY=1

# ---- PostgreSQL (disarankan versi 13 ke atas) -------------------------
# Pakai user khusus aplikasi (lihat deploy/db-roles.sql), bukan postgres/superuser.
DATABASE_URL=postgresql://ipad_app:GANTI_PASSWORD@localhost:5432/ipad_asset
DB_SSL=false
# User pemilik skema, HANYA dipakai saat migrate (boleh dikosongkan bila sama)
DATABASE_URL_MIGRATE=postgresql://ipad_owner:GANTI_PASSWORD@localhost:5432/ipad_asset

# ---- Session -----------------------------------------------------------
# Minimal 32 karakter acak. Buat dengan: npm run gen-keys
SESSION_SECRET=
SESSION_IDLE_MIN=60
SESSION_MAX_HOURS=10

# ---- Microsoft Entra ID (Azure AD) – lihat docs/ENTRA-SETUP.md ------------
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_SECRET=
# Hanya email dengan domain ini yang boleh login (pisahkan koma)
ALLOWED_EMAIL_DOMAINS=hirose.co.id
# false = hanya user yang sudah didaftarkan IT Admin yang bisa login (disarankan)
AUTO_PROVISION=false

# ---- Enkripsi credential (AES-256-GCM) ---------------------------------
# Format: id:base64(32 byte),id2:base64(32 byte). Buat dengan: npm run gen-keys
# Simpan cadangan kunci di tempat aman (password manager / brankas). Kunci hilang = data credential tidak bisa dibuka.
DATA_KEYS=
DATA_KEY_ACTIVE=k1
# Kunci HMAC untuk deteksi passcode duplikat tanpa dekripsi (32 byte base64)
HMAC_KEY=

# ---- Lain-lain ---------------------------------------------------------
UPLOAD_DIR=D:\\ipad-asset-data\\uploads
MAX_UPLOAD_MB=5
LOG_LEVEL=info
# Login tanpa Microsoft khusus development lokal. Ditolak otomatis bila NODE_ENV=production.
DEV_LOGIN=false
