{
  "name": "ipad-asset-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "iPad Asset Management – API (Node.js + PostgreSQL + Microsoft Entra ID)",
  "engines": { "node": ">=20.11" },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node db/migrate.js",
    "seed": "node db/seed.js",
    "create-admin": "node scripts/create-admin.js",
    "gen-keys": "node scripts/gen-keys.js",
    "rotate-keys": "node scripts/rotate-keys.js",
    "import-csv": "node scripts/import-devices-csv.js",
    "audit:deps": "npm audit --omit=dev"
  },
  "dependencies": {
    "@azure/msal-node": "^5.2.3",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "multer": "^2.0.2",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "zod": "^3.24.1"
  }
}
