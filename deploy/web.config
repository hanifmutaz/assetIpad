<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS reverse proxy → Node.js (127.0.0.1:4000)
  Prasyarat (sekali, lihat docs/DEPLOY-WINDOWS.md):
    1. Install modul IIS "URL Rewrite" dan "Application Request Routing (ARR)"
    2. ARR: aktifkan proxy + preserveHostHeader
    3. Izinkan server variable HTTP_X_FORWARDED_PROTO & HTTP_X_FORWARDED_HOST
  Site IIS ini cukup berisi file web.config saja (folder kosong).
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="ToNode" stopProcessing="true">
          <match url="(.*)" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
            <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
          </serverVariables>
          <action type="Rewrite" url="http://127.0.0.1:4000/{R:1}" logRewrittenUrl="true" />
        </rule>
      </rules>
    </rewrite>
    <security>
      <requestFiltering removeServerHeader="true">
        <requestLimits maxAllowedContentLength="10485760" />
        <hiddenSegments>
          <add segment=".env" />
          <add segment=".git" />
        </hiddenSegments>
      </requestFiltering>
    </security>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
